@model MvcOnlineTicariOtomasyon.Models.Siniflar.Class3
@{
    ViewBag.Title = "Deneme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script src="~/Scripts/jquery-3.7.1.min.js"></script>

<br />
<div>
    <h2>Kategoriler - Ürünler</h2>
</div>
<br />

<div>
    @Html.Label("Kategoriler")
    @Html.DropDownList("DrpKategori", Model.Kategoriler, "Kategori Seçiniz...", new { @class = "form-control" })
</div>
<br />

<div>
    @Html.Label("Ürünler")
    @Html.DropDownList("DrpUrun", Model.Urunler, "Ürün Seçiniz...", new { @class = "form-control" })
</div>

<script>
    $(function () {
        $('#DrpKategori').change(function () {
            var id = $(this).val();

            // Eğer "Kategori Seçiniz..." seçilmişse AJAX isteği atma, sadece alt kutuyu temizle
            if (!id) {
                $('#DrpUrun').empty();
                $('#DrpUrun').append("<option value=''>Ürün Seçiniz...</option>");
                return;
            }

            $.ajax({
                url: '/Kategori/UrunGetir', // Controller isminizin KategoriController olduğundan emin olun.
                data: { p: id },
                type: "POST",
                dataType: "json",
                success: function (data) {
                    // Dropdown'ı temizle ve varsayılan seçeneği ekle
                    $('#DrpUrun').empty();
                    $('#DrpUrun').append("<option value=''>Ürün Seçiniz...</option>");

                    // Gelen JSON verisini dön ve Dropdown'a ekle
                    $.each(data, function (index, item) {
                        $('#DrpUrun').append("<option value='" + item.Value + "'>" + item.Text + "</option>");
                    });
                },
                error: function (xhr, status, error) {
                    console.log("Veri çekilirken bir hata oluştu: " + error);
                }
            });
        });
    });
</script>