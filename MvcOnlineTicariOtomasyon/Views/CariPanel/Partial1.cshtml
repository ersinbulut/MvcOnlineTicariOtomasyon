@model MvcOnlineTicariOtomasyon.Models.Siniflar.Cariler

@Html.BeginForm("CariBilgiGuncelle", "CariPanel", FormMethod.Post)
{
    <div class="form-group row">

        <label for="inputName" class="col-sm-2 col-form-label">Ad</label>

        <div class="col-sm-10">

            @Html.HiddenFor(x => x.CariID)
            @Html.TextBoxFor(x => x.CariAd, new { @class = "form-control", placeholder = "Ad" })

        </div>

    </div> 

    <div class="form-group row">

        <label for="inputEmail" class="col-sm-2 col-form-label">Soyad</label>

        <div class="col-sm-10">

            @Html.TextBoxFor(x => x.CariSoyad, new { @class = "form-control", placeholder = "Soyad" })

        </div>

    </div>

    <div class="form-group row">

        <label for="inputName2" class="col-sm-2 col-form-label">Mail</label>

        <div class="col-sm-10">

            @Html.TextBoxFor(x => x.CariMail, new { @class = "form-control", placeholder = "Mail" })

        </div>

    </div>

    <div class="form-group row">

        <label for="inputExperience" class="col-sm-2 col-form-label">Şehir</label>

        <div class="col-sm-10">

            @Html.TextBoxFor(x => x.CariSehir, new { @class = "form-control", placeholder = "Şehir" })

        </div>

    </div>

    <div class="form-group row">

        <label for="inputSkills" class="col-sm-2 col-form-label">Şifre</label>

        <div class="col-sm-10">

            @Html.PasswordFor(x => x.CariSifre, new { @class = "form-control", placeholder = "Şifre" })

        </div>

    </div>

    <div class="form-group row">

        <div class="offset-sm-2 col-sm-10">

            <div class="checkbox">

                <label>

                    <input type="checkbox">Şifremi değiştirmek istiyorum</a>

                </label>

            </div>

        </div>

    </div>

    <div class="form-group row">

        <div class="offset-sm-2 col-sm-10">

            <button type="submit" class="btn btn-danger">Güncelle</button>

        </div>

    </div>
}